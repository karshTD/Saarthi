# Copy to .env and fill in. Never commit .env.

# --- Backend ---------------------------------------------------------------
# SQLite for local dev; managed Postgres (e.g. Neon) in production.
DATABASE_URL=sqlite:///./saarthi_demo.db

# Optional. With no key the app uses built-in lesson templates (labelled "template").
# This is the only paid service Saarthi can use (Anthropic API, pay per token).
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Shared access code required in the X-Access-Code header. Empty = no gate (local dev only).
ACCESS_CODE=

# Comma-separated frontend origins allowed by CORS (no trailing slash).
CORS_ORIGINS=http://localhost:3000

# Max AI requests per client IP per minute. 0 disables limiting.
AI_RATE_LIMIT_PER_MINUTE=10

# "true" = load synthetic demo data on start (idempotent). Never use with real data.
SEED_ON_START=false

# --- Frontend (baked in at build time) --------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
